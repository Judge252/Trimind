{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "functions":{"api/index.ts":{"maxDuration":60,"includeFiles":"{server/model-selection.json,server/certs/supabase-ca.crt}","excludeFiles":"{server/.model-eval-budget.json,**/.env,**/.env.*}"}},
  "rewrites":[{"source":"/api/:path*","destination":"/api"},{"source":"/((?!assets/).*)","destination":"/index.html"}],
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}]}]
}
